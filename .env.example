CAD_ADMIN_USERNAME=dispatch
CAD_ADMIN_PASSWORD=dispatch
# Leave blank -- generated automatically on first boot and persisted in /data.
SESSION_SECRET=
# Leave blank -- set this and the poll interval from the Configuration page
# once the app is running instead.
APRSFI_API_KEY=
APRS_POLL_SECONDS=60
DATABASE_PATH=/data/cad.sqlite3

DRATS_INGEST_TOKEN=

TZ=Europe/Rome
LANG=it_IT.UTF-8
NTP_SERVER=pool.ntp.org

# This initial value only matters before anyone's set one from the
# Configuration page instead -- the DB setting takes over after that.
MDNS_HOSTNAME=cad-server
MDNS_ENABLED=true

PORT=80

HTTPS_ENABLED=false
HTTPS_PORT=443
CERT_DIR=/data/certs

NETWORK_MONITOR_ENABLED=true
NETWORK_MONITOR_POLL_SECONDS=30
IPERF_TEST_SECONDS=5
